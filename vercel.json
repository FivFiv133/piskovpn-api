{
  "functions": {
    "api/subscription.js": {
      "includeFiles": "{PiskoVPN.txt,PiskoVPN.json}"
    }
  },
  "rewrites": [
    { "source": "/sub", "destination": "/api/subscription" },
    { "source": "/sub.json", "destination": "/api/subscription?format=json" },
    { "source": "/config.json", "destination": "/api/subscription?format=json" },
    { "source": "/PiskoVPN.json", "destination": "/api/subscription?format=json" },
    { "source": "/PiskoVPN.txt", "destination": "/api/subscription?format=txt" },
    { "source": "/stats", "destination": "/api/stats" },
    { "source": "/sync", "destination": "/api/sync" },
    { "source": "/health", "destination": "/api/health" }
  ]
}

